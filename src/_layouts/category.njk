---
layout: base.njk
---
{% from "nav-tree.njk" import renderNavTree %}

<div class="page">
  {% include "breadcrumbs.njk" %}

  <h1 class="page-title">{{ title }}</h1>
  {% if description %}
    <p class="page-description">{{ description }}</p>
  {% endif %}

  <nav class="toc">
    {% set children = navigation | getChildren(page.url) %}
    {{ renderNavTree(children) }}
  </nav>
</div>
