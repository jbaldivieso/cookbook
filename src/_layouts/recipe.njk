---
layout: base.njk
---

<div class="page">
  {% include "breadcrumbs.njk" %}

  <div class="title-row">
    <h1 class="page-title">{{ title }}</h1>
    {# Revealed by enableWakeLock, so it never shows as a dead control without JS #}
    <button type="button" id="wake-lock-switch" class="wake-switch" role="switch" aria-checked="false" hidden>
      <span class="wake-switch-label">Keep screen on</span>
      <span class="wake-switch-track" aria-hidden="true"></span>
    </button>
  </div>

  <article class="recipe-body">
    {{ content | recipeSections | safe }}
  </article>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (window.enableWakeLock) {
      window.enableWakeLock();
    }
    if (window.initRecipeScaling) {
      window.initRecipeScaling();
    }
    if (window.initListItemToggle) {
      window.initListItemToggle();
    }
    if (window.initTimeline) {
      window.initTimeline();
    }
  });
</script>
